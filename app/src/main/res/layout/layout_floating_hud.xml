<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Collapsed Floating Bubble View -->
    <LinearLayout
        android:id="@+id/layoutCollapsedBubble"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/card_rounded"
        android:backgroundTint="@color/claw_primary"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_claw"
            app:tint="@color/claw_text_primary" />

        <View
            android:id="@+id/bubbleStatusDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/dot_indicator"
            android:backgroundTint="@color/claw_success" />
    </LinearLayout>

    <!-- Expanded Floating Watcher Panel -->
    <LinearLayout
        android:id="@+id/layoutExpandedPanel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:background="@drawable/card_rounded"
        android:backgroundTint="@color/claw_card_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_claw"
                    app:tint="@color/claw_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Jarvis Watcher"
                    android:textColor="@color/claw_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCollapsePanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="monospace"
                android:padding="2dp"
                android:text="[✕]"
                android:textColor="@color/claw_text_secondary"
                android:textSize="13sp" />
        </RelativeLayout>

        <!-- Live Status Ticker -->
        <TextView
            android:id="@+id/tvOverlayTicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/console_bg"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:text="Watching in background..."
            android:textColor="@color/claw_console_text"
            android:textSize="11sp" />

        <!-- Quick Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayInspect"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="📸 Screen AI"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayHome"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="🏠 Home"
                android:textColor="@color/claw_text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Quick Prompt Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/console_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <EditText
                android:id="@+id/etOverlayPrompt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Command AI..."
                android:imeOptions="actionSend"
                android:inputType="text"
                android:textColor="@color/claw_text_primary"
                android:textColorHint="@color/claw_text_secondary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnOverlaySend"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_send"
                app:tint="@color/claw_accent" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
